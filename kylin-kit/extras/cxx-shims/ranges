// PDFium Kylin kit: minimal C++20 <ranges> replacement for the GCC 8
// libstdc++ in this sysroot. Covers the subset PDFium and its bundled abseil
// use: enable_view / enable_borrowed_range (fully specializable), the range
// concepts gating span construction, member-based begin/end/size/data CPOs
// (plus array and initializer_list forms), and the algorithms
// ranges::{copy, copy_backward, equal, find, find_if, fill}. Header-only;
// introduces no runtime symbols.

#ifndef PDFIUM_KIT_COMPAT_RANGES_H_
#define PDFIUM_KIT_COMPAT_RANGES_H_

#include <algorithm>
#include <concepts>
#include <cstddef>
#include <functional>
#include <initializer_list>
#include <iterator>
#include <type_traits>
#include <utility>

namespace std {
namespace ranges {

// ---- customization variables (must stay fully specializable) ----
template <typename T>
inline constexpr bool enable_view = is_class_v<T>;

template <typename T>
inline constexpr bool enable_borrowed_range = false;

// ---- CPOs: member-function based, plus array / initializer_list forms ----
template <typename T, size_t N>
constexpr T* begin(T (&array)[N]) noexcept {
  return array;
}

template <typename T, size_t N>
constexpr T* end(T (&array)[N]) noexcept {
  return array + N;
}

template <typename T, size_t N>
constexpr size_t size(const T (&array)[N]) noexcept {
  return N;
}

template <typename T, size_t N>
constexpr T* data(T (&array)[N]) noexcept {
  return array;
}

template <typename E>
constexpr const E* data(initializer_list<E> il) noexcept {
  return il.begin();
}

template <typename R>
constexpr auto begin(R&& r) noexcept(noexcept(r.begin()))
    -> decltype(r.begin()) {
  return r.begin();
}

template <typename R>
constexpr auto end(R&& r) noexcept(noexcept(r.end())) -> decltype(r.end()) {
  return r.end();
}

template <typename R>
constexpr auto size(R&& r) noexcept(noexcept(r.size())) -> decltype(r.size()) {
  return r.size();
}

template <typename R>
constexpr auto data(R&& r) noexcept(noexcept(r.data())) -> decltype(r.data()) {
  return r.data();
}

// ---- range traits ----
template <typename R>
using iterator_t = decltype(begin(declval<R&>()));

template <typename R>
using sentinel_t = decltype(end(declval<R&>()));

template <typename R>
using range_reference_t = decltype(*begin(declval<R&>()));

template <typename R>
using range_value_t = remove_reference_t<range_reference_t<R>>;

// ---- range concepts ----
template <typename R>
concept range = requires(R& r) {
  ranges::begin(r);
  ranges::end(r);
};

template <typename R>
concept sized_range = range<R> && requires(R& r) { ranges::size(r); };

template <typename R>
concept borrowed_range =
    is_lvalue_reference_v<R> || enable_borrowed_range<remove_cvref_t<R>>;

template <typename R>
concept contiguous_range =
    sized_range<R> &&
    requires(R& r) {
      { ranges::data(r) } -> same_as<
          add_pointer_t<remove_reference_t<range_reference_t<R>>>>;
    };

// ---- algorithms ----
template <typename R, typename OutputIt>
constexpr auto copy(R&& r, OutputIt out)
    -> decltype(std::copy(begin(r), end(r), out)) {
  return std::copy(begin(r), end(r), out);
}

template <typename InputIt, typename Sentinel, typename OutputIt>
constexpr auto copy(InputIt first, Sentinel last, OutputIt out)
    -> decltype(std::copy(first, last, out)) {
  return std::copy(first, last, out);
}

template <typename R, typename OutputIt>
constexpr auto copy_backward(R&& r, OutputIt out)
    -> decltype(std::copy_backward(begin(r), end(r), out)) {
  return std::copy_backward(begin(r), end(r), out);
}

template <typename InputIt, typename Sentinel, typename OutputIt>
constexpr auto copy_backward(InputIt first, Sentinel last, OutputIt out)
    -> decltype(std::copy_backward(first, last, out)) {
  return std::copy_backward(first, last, out);
}

template <typename R1, typename R2>
constexpr auto equal(R1&& a, R2&& b)
    -> decltype(std::equal(begin(a), end(a), begin(b), end(b))) {
  return std::equal(begin(a), end(a), begin(b), end(b));
}

template <typename R, typename Value>
constexpr auto find(R&& r, const Value& v)
    -> decltype(std::find(begin(r), end(r), v)) {
  return std::find(begin(r), end(r), v);
}

template <typename R, typename Value, typename Proj>
constexpr auto find(R&& r, const Value& v, Proj proj)
    -> decltype(begin(r)) {
  auto first = begin(r);
  auto last = end(r);
  for (; first != last; ++first) {
    if (std::invoke(proj, *first) == v) {
      break;
    }
  }
  return first;
}

template <typename R, typename Pred>
constexpr auto find_if(R&& r, Pred pred)
    -> decltype(std::find_if(begin(r), end(r), pred)) {
  return std::find_if(begin(r), end(r), pred);
}

template <typename R, typename Value>
constexpr auto fill(R&& r, const Value& v)
    -> decltype(std::fill(begin(r), end(r), v)) {
  return std::fill(begin(r), end(r), v);
}

// ---- binary search (lower_bound / upper_bound with projection) ----
struct less {
  template <typename L, typename R>
  constexpr bool operator()(L&& lhs, R&& rhs) const {
    return static_cast<L&&>(lhs) < static_cast<R&&>(rhs);
  }
};

struct identity {
  template <typename T>
  constexpr T&& operator()(T&& t) const noexcept {
    return static_cast<T&&>(t);
  }
};

namespace kit_detail {
template <typename Comp, typename Proj>
struct projected_less {
  Comp comp;
  Proj proj;
  template <typename E, typename V>
  constexpr bool operator()(E&& e, V&& v) const {
    return std::invoke(comp, std::invoke(proj, static_cast<E&&>(e)), v);
  }
};

template <typename Comp, typename Proj>
struct projected_less_rev {
  Comp comp;
  Proj proj;
  template <typename E, typename V>
  constexpr bool operator()(const V& v, E&& e) const {
    return std::invoke(comp, v, std::invoke(proj, static_cast<E&&>(e)));
  }
};
}  // namespace kit_detail

template <typename R, typename T, typename Comp = ranges::less,
          typename Proj = ranges::identity>
constexpr auto lower_bound(R&& r, const T& v, Comp comp = Comp(),
                           Proj proj = Proj())
    -> decltype(std::lower_bound(
        begin(r), end(r), v,
        kit_detail::projected_less<Comp, Proj>{std::move(comp),
                                               std::move(proj)})) {
  return std::lower_bound(begin(r), end(r), v,
                          kit_detail::projected_less<Comp, Proj>{
                              std::move(comp), std::move(proj)});
}

template <typename R, typename T, typename Comp = ranges::less,
          typename Proj = ranges::identity>
constexpr auto upper_bound(R&& r, const T& v, Comp comp = Comp(),
                           Proj proj = Proj())
    -> decltype(std::upper_bound(
        begin(r), end(r), v,
        kit_detail::projected_less_rev<Comp, Proj>{std::move(comp),
                                                   std::move(proj)})) {
  return std::upper_bound(begin(r), end(r), v,
                          kit_detail::projected_less_rev<Comp, Proj>{
                              std::move(comp), std::move(proj)});
}

}  // namespace ranges
}  // namespace std

#endif  // PDFIUM_KIT_COMPAT_RANGES_H_
